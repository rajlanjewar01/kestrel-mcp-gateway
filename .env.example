# Kestrel MCP Gateway - Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# SYS-1 WMS
WMS_BASE_URL=http://wms-stub:8081
WMS_API_KEY=changeme

# SYS-2 TMS
TMS_BASE_URL=http://tms-stub:8082
TMS_CLIENT_ID=changeme
TMS_CLIENT_SECRET=changeme

# SYS-3 Ticketing
TICKETING_BASE_URL=http://ticketing-stub:8083
TICKETING_BEARER_TOKEN=changeme

# SYS-4 Contracts
CONTRACTS_BASE_URL=http://contracts-stub:8084
CONTRACTS_CERT_PATH=/app/certs/client.pem
CONTRACTS_KEY_PATH=/app/certs/client.key

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
KILL_SWITCH_PATH=/app/kill_switch.json
AUDIT_LOG_PATH=/app/audit_logs
